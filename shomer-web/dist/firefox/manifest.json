{
    "manifest_version":  3,
    "name":  "__MSG_extName__",
    "short_name":  "Shomer Web",
    "description":  "__MSG_extDescription__",
    "version":  "0.1.0",
    "default_locale":  "es",
    "icons":  {
                  "16":  "icons/icon16.png",
                  "48":  "icons/icon48.png",
                  "128":  "icons/icon128.png"
              },
    "action":  {
                   "default_title":  "Shomer Web",
                   "default_popup":  "popup/popup.html",
                   "default_icon":  {
                                        "16":  "icons/icon16.png",
                                        "48":  "icons/icon48.png"
                                    }
               },
    "background":  {
                       "scripts":  [
                                       "common/i18n.js",
                                       "common/settings.js",
                                       "background.js"
                                   ]
                   },
    "permissions":  [
                        "storage",
                        "declarativeNetRequest"
                    ],
    "host_permissions":  [
                             "\u003call_urls\u003e"
                         ],
    "content_scripts":  [
                            {
                                "matches":  [
                                                "http://*/*",
                                                "https://*/*"
                                            ],
                                "js":  [
                                           "common/i18n.js",
                                           "common/settings.js",
                                           "content/cosmetic-adblock.js",
                                           "content/ad-break-detector.js",
                                           "content/video-filter.js",
                                           "content/image-filter.js",
                                           "content/content.js"
                                       ],
                                "css":  [
                                            "content/overlay.css"
                                        ],
                                "run_at":  "document_start",
                                "all_frames":  true
                            }
                        ],
    "declarative_net_request":  {
                                    "rule_resources":  [
                                                           {
                                                               "id":  "ads",
                                                               "enabled":  true,
                                                               "path":  "rules/ad_rules.json"
                                                           }
                                                       ]
                                },
    "web_accessible_resources":  [
                                     {
                                         "resources":  [
                                                           "engine/engine.html"
                                                       ],
                                         "matches":  [
                                                         "\u003call_urls\u003e"
                                                     ]
                                     }
                                 ],
    "content_security_policy":  {
                                    "extension_pages":  "script-src \u0027self\u0027 \u0027wasm-unsafe-eval\u0027; object-src \u0027self\u0027"
                                },
    "browser_specific_settings":  {
                                      "gecko":  {
                                                    "id":  "shomer-web@local",
                                                    "strict_min_version":  "128.0",
                                                    "data_collection_permissions":  {
                                                                                        "required":  [
                                                                                                         "none"
                                                                                                     ]
                                                                                    }
                                                }
                                  }
}